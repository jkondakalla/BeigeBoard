# BeigeBoard backend environment variables
PORT=3001
DB_PATH=./beigeBoard.db

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Microsoft / Outlook OAuth2
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/outlook/callback

# ORDECK auth (JWT shared with ordeck auth-api)
JWT_SECRET=
SHELL_URL=http://localhost:3000

# Standalone login password (used when BeigeBoard is deployed without the ORDECK shell)
LOGIN_PASSWORD=

# LazurOS AI compute
# Docker: http://host.docker.internal:8080
# Dev:    http://localhost:8080
LAZUROS_URL=http://localhost:8080
LAZUROS_TOKEN=
LAZUROS_DEFAULT_MODEL=llama3.2
